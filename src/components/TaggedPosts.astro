---
import { getCollection } from 'astro:content';
import FormattedDate from './FormattedDate.astro';

interface Props {
	tags: string[];
	emptyText?: string;
}

const { tags, emptyText = 'No posts in this section yet — check back soon.' } = Astro.props;

const posts = (await getCollection('blog'))
	.filter((post) => post.data.tags?.some((tag) => tags.includes(tag)))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

{
	posts.length === 0 ? (
		<p class="empty">{emptyText}</p>
	) : (
		<ul class="post-list">
			{posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						<span class="meta">
							<span class="date">
								<FormattedDate date={post.data.pubDate} />
							</span>
							{post.data.tags?.length > 0 && <span class="tags">{post.data.tags.join(' · ')}</span>}
						</span>
						<span class="title">{post.data.title}</span>
						<span class="desc">{post.data.description}</span>
					</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.35rem;
	}
	.post-list a {
		display: grid;
		gap: 0.2rem;
		padding: 1rem 0;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
		color: inherit;
	}
	.post-list a:hover .title {
		color: var(--accent);
	}
	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
		font-size: 0.85rem;
		color: var(--muted);
	}
	.tags {
		text-transform: lowercase;
	}
	.title {
		font-family: var(--font-display);
		font-size: 1.25rem;
		font-weight: 700;
		color: var(--ink);
	}
	.desc {
		color: var(--muted);
	}
	.empty {
		color: var(--muted);
	}
</style>
