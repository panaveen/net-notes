---
import { CERTIFICATIONS, RESOURCE_SECTIONS, SITE_TITLE, TECHNOLOGY } from '../consts';

const path = Astro.url.pathname;
const techActive = path.startsWith('/technology');
const certActive = path.startsWith('/certification');
const postsActive = path.startsWith('/blog');
const resourcesActive = path.startsWith('/resources');
const aboutActive = path.startsWith('/about');
const homeActive = path === '/' || path === '';
---

<header>
	<nav>
		<a class="brand" href="/">{SITE_TITLE}</a>
		<button
			class="menu-toggle"
			type="button"
			aria-expanded="false"
			aria-controls="site-nav"
			aria-label="Open menu"
		>
			<span class="menu-toggle-bars" aria-hidden="true"></span>
		</button>
		<div class="internal-links" id="site-nav">
			<a class:list={[{ active: homeActive }]} href="/">Home</a>

			<div class:list={['menu', { active: techActive }]}>
				<a class="menu-trigger" href="/technology">Technology</a>
				<div class="dropdown" role="menu">
					<a href="/technology">Overview</a>
					{TECHNOLOGY.map((item) => <a href={item.href}>{item.title}</a>)}
				</div>
			</div>

			<div class:list={['menu', { active: certActive }]}>
				<a class="menu-trigger" href="/certification">Certification</a>
				<div class="dropdown" role="menu">
					<a href="/certification">Overview</a>
					{
						CERTIFICATIONS.map((item) =>
							item.children.length > 0 ? (
								<div class="submenu">
									<a class="submenu-trigger" href={item.href}>
										{item.title}
									</a>
									<div class="flyout">
										{item.children.map((child) => (
											<a href={child.href}>{child.title}</a>
										))}
									</div>
								</div>
							) : (
								<a href={item.href}>{item.title}</a>
							),
						)
					}
				</div>
			</div>

			<a class:list={[{ active: postsActive }]} href="/blog">Posts</a>

			<div class:list={['menu', { active: resourcesActive }]}>
				<a class="menu-trigger" href="/resources">Resources</a>
				<div class="dropdown" role="menu">
					<a href="/resources">Overview</a>
					{RESOURCE_SECTIONS.map((item) => <a href={item.href}>{item.title}</a>)}
				</div>
			</div>

			<a class:list={[{ active: aboutActive }]} href="/about">About</a>
		</div>
	</nav>
</header>

<script>
	const header = document.querySelector('header');
	const toggle = document.querySelector('.menu-toggle');
	const nav = document.querySelector('#site-nav');
	if (toggle instanceof HTMLButtonElement && nav instanceof HTMLElement && header) {
		const setOpen = (open) => {
			header.classList.toggle('nav-open', open);
			toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
		};
		toggle.addEventListener('click', () => {
			setOpen(!header.classList.contains('nav-open'));
		});
		nav.querySelectorAll('a').forEach((link) => {
			link.addEventListener('click', () => setOpen(false));
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') setOpen(false);
		});
	}
</script>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 20;
		backdrop-filter: blur(10px);
		background: rgba(243, 247, 244, 0.92);
		border-bottom: 1px solid var(--line);
	}
	nav {
		width: 960px;
		max-width: calc(100% - 2em);
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.85rem 0;
		position: relative;
	}
	.brand {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.15rem;
		letter-spacing: -0.03em;
		color: var(--ink);
		text-decoration: none;
	}
	.brand:hover {
		color: var(--accent);
	}
	.menu-toggle {
		display: none;
		width: 2.5rem;
		height: 2.5rem;
		border: 1px solid var(--line);
		border-radius: 6px;
		background: transparent;
		padding: 0;
		align-items: center;
		justify-content: center;
		cursor: pointer;
	}
	.menu-toggle-bars,
	.menu-toggle-bars::before,
	.menu-toggle-bars::after {
		display: block;
		width: 1.1rem;
		height: 2px;
		background: var(--ink);
		border-radius: 1px;
		position: relative;
		transition: transform 0.2s ease;
	}
	.menu-toggle-bars::before,
	.menu-toggle-bars::after {
		content: '';
		position: absolute;
		left: 0;
	}
	.menu-toggle-bars::before {
		top: -6px;
	}
	.menu-toggle-bars::after {
		top: 6px;
	}
	:global(header.nav-open) .menu-toggle-bars {
		background: transparent;
	}
	:global(header.nav-open) .menu-toggle-bars::before {
		top: 0;
		transform: rotate(45deg);
	}
	:global(header.nav-open) .menu-toggle-bars::after {
		top: 0;
		transform: rotate(-45deg);
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.15rem;
		justify-content: flex-end;
	}
	.internal-links > a,
	.menu-trigger {
		padding: 0.35rem 0.65rem;
		color: var(--ink-soft);
		text-decoration: none;
		font-size: 0.95rem;
		border-bottom: 2px solid transparent;
	}
	.menu-trigger::after {
		content: ' ▾';
		font-size: 0.75em;
		opacity: 0.7;
	}
	.internal-links > a.active,
	.internal-links > a:hover,
	.menu.active > .menu-trigger,
	.menu:hover > .menu-trigger,
	.menu:focus-within > .menu-trigger {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}
	.menu {
		position: relative;
	}
	.dropdown {
		position: absolute;
		top: calc(100% - 2px);
		left: 0;
		min-width: 11.5rem;
		display: grid;
		padding: 0.45rem;
		background: #f7fbf8;
		border: 1px solid var(--line);
		border-radius: 8px;
		box-shadow: var(--shadow-soft);
		opacity: 0;
		visibility: hidden;
		transform: translateY(6px);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease,
			visibility 0.15s ease;
		pointer-events: none;
	}
	.menu::after {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 100%;
		height: 0.5rem;
	}
	.menu:hover > .dropdown,
	.menu:focus-within > .dropdown {
		opacity: 1;
		visibility: visible;
		transform: translateY(0);
		pointer-events: auto;
	}
	.dropdown a,
	.submenu-trigger {
		padding: 0.5rem 0.7rem;
		color: var(--ink-soft);
		text-decoration: none;
		font-size: 0.92rem;
		border-radius: 4px;
		display: block;
	}
	.dropdown a:hover,
	.dropdown a:focus-visible,
	.submenu:hover > .submenu-trigger,
	.submenu:focus-within > .submenu-trigger {
		background: var(--paper-deep);
		color: var(--accent);
		outline: none;
	}
	.submenu {
		position: relative;
	}
	.submenu-trigger::after {
		content: ' ▸';
		float: right;
		opacity: 0.7;
	}
	.flyout {
		position: absolute;
		top: 0;
		left: calc(100% - 4px);
		min-width: 9.5rem;
		display: grid;
		padding: 0.45rem;
		background: #f7fbf8;
		border: 1px solid var(--line);
		border-radius: 8px;
		box-shadow: var(--shadow-soft);
		opacity: 0;
		visibility: hidden;
		transform: translateX(4px);
		transition:
			opacity 0.15s ease,
			transform 0.15s ease,
			visibility 0.15s ease;
		pointer-events: none;
	}
	.submenu:hover > .flyout,
	.submenu:focus-within > .flyout {
		opacity: 1;
		visibility: visible;
		transform: translateX(0);
		pointer-events: auto;
	}

	@media (max-width: 720px) {
		.menu-toggle {
			display: inline-flex;
		}
		.internal-links {
			display: none;
			position: absolute;
			top: calc(100% + 1px);
			left: 0;
			right: 0;
			width: auto;
			flex-direction: column;
			align-items: stretch;
			gap: 0.15rem;
			padding: 0.75rem;
			background: #f7fbf8;
			border: 1px solid var(--line);
			border-radius: 8px;
			box-shadow: var(--shadow-soft);
		}
		:global(header.nav-open) .internal-links {
			display: flex;
		}
		.internal-links > a,
		.menu-trigger {
			padding: 0.7rem 0.75rem;
			border-bottom: none;
			border-radius: 6px;
		}
		.menu-trigger::after {
			content: '';
		}
		.dropdown,
		.flyout {
			display: none;
		}
		/* On mobile, top-level items go straight to hub pages; no expanded sublists */
		.menu:hover > .dropdown,
		.menu:focus-within > .dropdown,
		.submenu:hover > .flyout,
		.submenu:focus-within > .flyout {
			display: none;
		}
	}
</style>
