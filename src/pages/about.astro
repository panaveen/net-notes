---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About | ${SITE_TITLE}`}
			description="About Net Field Notes — technology and certification study notes."
		/>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>About</h1>
				<p>
					{SITE_TITLE} is {SITE_AUTHOR}'s public notebook for enterprise networking — technology
					write-ups and certification study paths.
				</p>
			</header>
			<div class="prose">
				<p>
					Browse by <a href="/technology">Technology</a> (Network, Security, Automation) or by{' '}
					<a href="/certification">Certification</a> (CWNP, Cisco, Juniper).
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head {
		margin-bottom: 1.5rem;
	}
	.page-head p {
		color: var(--muted);
		margin: 0.75rem 0 0;
		max-width: 48ch;
	}
</style>
