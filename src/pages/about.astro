---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_AUTHOR, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`About | ${SITE_TITLE}`}
			description="About Net Field Notes — networking, WLAN, and security study notes."
		/>
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>About</h1>
				<p>
					{SITE_TITLE} is {SITE_AUTHOR}'s public notebook for enterprise networking — WLAN, routing,
					security, and labs from real work.
				</p>
			</header>
			<div class="prose">
				<p>
					WLAN is a first-class section here (including a CWNA → CWNE study path), but the site is
					not limited to Wi‑Fi. Expect posts on DNS, firewalls, campus/DC design, and short incident
					write-ups when they teach something reusable.
				</p>
				<p>
					Built with Astro and hosted on Cloudflare Pages. Posts are Markdown in git — easy to
					draft, review, and improve over time.
				</p>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	.page-head {
		margin-bottom: 1.5rem;
	}
	.page-head p {
		color: var(--muted);
		margin: 0.75rem 0 0;
		max-width: 48ch;
	}
</style>
