---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Posts | ${SITE_TITLE}`} description="All WLAN Notes blog posts." />
	</head>
	<body>
		<Header />
		<main>
			<header class="page-head">
				<h1>Posts</h1>
				<p>Study notes, labs, and WLAN engineering write-ups.</p>
			</header>
			<ul class="post-list">
				{
					posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<span class="title">{post.data.title}</span>
								<span class="desc">{post.data.description}</span>
							</a>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		width: 820px;
	}
	.page-head {
		margin-bottom: 1.75rem;
	}
	.page-head p {
		margin: 0.5rem 0 0;
		color: var(--muted);
	}
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.5rem;
	}
	.post-list a {
		display: grid;
		gap: 0.2rem;
		padding: 1.1rem 0;
		border-bottom: 1px solid var(--line);
		text-decoration: none;
		color: inherit;
	}
	.post-list a:hover .title {
		color: var(--accent);
	}
	.date {
		font-size: 0.85rem;
		color: var(--muted);
	}
	.title {
		font-family: var(--font-display);
		font-size: 1.4rem;
		font-weight: 700;
		color: var(--ink);
	}
	.desc {
		color: var(--muted);
	}
</style>
